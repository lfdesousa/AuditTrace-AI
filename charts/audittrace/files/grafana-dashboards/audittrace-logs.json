{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "audittrace", "value": "audittrace" }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Filter (grep, blank = all)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "stat",
      "title": "request-scoped lines missing trace_id (memory.read, 24 h)",
      "description": "Share of memory.read log lines with no trace_id over the last 24 h (LOG-TRACE-ID). Reads ~100 % until the first deploy carrying LOG-TRACE-ID; the render check compares against the deploy timestamp.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"memory-server\"} |= \"memory.read\" | json | trace_id=\"\" [24h])) / sum(count_over_time({container=\"memory-server\"} |= \"memory.read\" [24h]))",
          "instant": true,
          "queryType": "instant",
          "legendFormat": "missing trace_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume — $service",
      "description": "Log lines per interval for the selected service, honouring the grep filter. Loki count_over_time.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"$service\"} |= \"$search\" [$__interval]))",
          "legendFormat": "lines"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        }
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs — $service",
      "description": "Raw log stream for the selected service. Type in the Filter box to grep (LogQL |=).",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"$service\"} |= \"$search\"" }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["audittrace-ai", "logs", "loki"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AuditTrace-AI — Logs (Loki)",
  "uid": "audittrace-logs",
  "version": 1
