      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "aud-audittrace-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "audittrace-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "description": "Deliberately under-privileged Device Flow client for adversarial verification (SC-09). Holds NO audit/admin scope in EITHER scope set, so its token cannot be widened by asking. Do not add one. See docs/ADR-059 and tests/test_chart_drift_guards.py.",
      "clientId": "audittrace-restricted",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "urn:ietf:wg:oauth:2.0:oob",
        "http://localhost:*"
      ],
      "webOrigins": [
        "+"
