    {
      "description": "Public client for first-party browser UIs (LibreChat, future audit dashboards). OAuth2 Authorization Code + PKCE per ADR-042. Used as the chat-flow client for ADR-044 live federation evidence.",
      "clientId": "audittrace-webui",
      "name": "AuditTrace Web UI (browser auth-code flow + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
{{- $webuiRedirectUris := concat .Values.keycloak.webui.redirectUris .Values.keycloak.webui.devRedirectUris }}
{{- range $i, $uri := $webuiRedirectUris }}{{ if $i }},{{ end }}
        "{{ $uri }}"
{{- end }}
      ],
      "webOrigins": [
{{- $webuiWebOrigins := concat .Values.keycloak.webui.webOrigins .Values.keycloak.webui.devWebOrigins }}
{{- range $i, $origin := $webuiWebOrigins }}{{ if $i }},{{ end }}
        "{{ $origin }}"
{{- end }}
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{ .Values.keycloak.webui.postLogoutRedirectUri }}"
      },
      "defaultClientScopes": [
        "audittrace:query",
        "audittrace:context",
        "audittrace:audit",
        "memory:episodic:read",
        "memory:procedural:read",
        "memory:conversational:read-own",
