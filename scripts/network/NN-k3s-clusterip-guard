#!/usr/bin/env bash
# NN-k3s-clusterip-guard — SPEC #443 v2 s3, the SAFE NetworkManager dispatcher.
#
# NetworkManager dispatcher hook (see nm-dispatcher(8)): fires on every
# `up`/`down`/`connectivity-change` event, called by NM itself as ROOT with
# ($1=interface, $2=action). This file is the THIN, no-op-by-default shell
# wrapper NM actually executes; ALL decision logic (debounce, lock, the
# only-restart-when-genuinely-broken policy) lives in the testable Python
# module `scripts/network/k3s_clusterip_dispatcher.py` — see that module's
# docstring for the full safety design and for why the v1 dispatcher
# (removed 2026-08-09 as part of the #443 revert) was harmful: it "repaired
# routes" using logic tied to a structural fix (a pinned k3s0 dummy
# interface) that itself broke the mesh on live apply. This dispatcher does
# ONE thing when the guard proves the pod->ClusterIP path is broken:
# `systemctl restart k3s` — the proven, bounded recovery from SPEC #443 v2 s2.
# It does NOTHING at steady state, and NOTHING when the guard is healthy.
#
# Filename note: NO extension, matching the v1 precedent — NetworkManager's
# dispatcher.d loader ignores files with certain extensions
# (.rpmsave/.rpmorig/.rpmnew/.swp/.bak/"~") and files without the executable
# bit; an extension-free, executable, root-owned file is the safest match to
# that contract.
#
# ── Out-of-band install (NOT in the Helm chart, host infra; operator-run) ──
#   sudo cp scripts/network/NN-k3s-clusterip-guard \
#           /etc/NetworkManager/dispatcher.d/90-k3s-clusterip-guard
#   sudo chmod 0755 /etc/NetworkManager/dispatcher.d/90-k3s-clusterip-guard
#
# NM requires dispatcher scripts to be root-owned and not group/world
# writable; `nmcli` reloads dispatcher.d automatically (no daemon restart
# needed for a new script to take effect on the NEXT event).
#
# INSTALL IS A COPY, NOT A SYMLINK — the installed file at
# `/etc/NetworkManager/dispatcher.d/90-k3s-clusterip-guard` is therefore no
# longer inside this repo checkout, so this script MUST locate the Python
# dispatcher module WITHOUT relying on its own on-disk location (an
# `readlink -f "${BASH_SOURCE[0]}"` + `../..` walk-up resolves into `/etc`
# under the documented `cp` install, never the repo — the 2026-08-09 REJECT
# finding: every NM event ran a wrapper that could not find its module and
# silently did nothing). See "Locate the repo" below for the fix: an
# explicit, portability-invariant env-var override with a laptop-reference
# default, the SAME override-with-default shape as `AUDITTRACE_FRONT_DOOR`
# elsewhere in this repo (`scripts/deploy/frontdoor.py`).
#
# ── Rollback (SPEC #443 v2 s5 point 5 — "one file") ────────────────────────
#   sudo rm /etc/NetworkManager/dispatcher.d/90-k3s-clusterip-guard
#
# ── Testing ─────────────────────────────────────────────────────────────────
# Set CLUSTERIP_GUARD_DRY_RUN=1 to log every decision WITHOUT running
# `systemctl restart k3s` (the guard itself is READ-ONLY and always runs for
# real; only the repair step is gated by DRY_RUN) — mirrors
# `audittrace-mesh-resettle.sh`'s `MESH_RESETTLE_DRY_RUN` convention.
#   CLUSTERIP_GUARD_DRY_RUN=1 ./NN-k3s-clusterip-guard wlan0 up
#
# Set AUDITTRACE_REPO_DIR to point this wrapper at a checkout other than the
# laptop-reference default below — e.g. when running the wrapper directly
# from a worktree/clone for testing, or when installing on a host whose
# checkout lives somewhere else (a NetworkManager.service systemd drop-in
# — `systemctl edit NetworkManager` — can set `Environment=
# AUDITTRACE_REPO_DIR=/path/to/AuditTrace-AI` so the DAEMON, and therefore
# every dispatcher script it execs, sees the override):
#   AUDITTRACE_REPO_DIR=/path/to/AuditTrace-AI ./NN-k3s-clusterip-guard wlan0 up

set -euo pipefail

# ── Locate the repo (independent of cp vs symlink install; see header) ────
# Precedence: AUDITTRACE_REPO_DIR env var (fresh at call time) > hardcoded
# laptop-reference default. This is a DEFAULT, not the only path — the same
# "environment-parameterized, laptop is one profile" shape used throughout
# this repo (portability invariant).
REPO_DIR="${AUDITTRACE_REPO_DIR:-/home/lfdesousa/work/AuditTrace-AI}"
DISPATCHER_MODULE="$REPO_DIR/scripts/network/k3s_clusterip_dispatcher.py"
PYTHON_BIN="${CLUSTERIP_GUARD_PYTHON:-python3}"

if [[ ! -f "$DISPATCHER_MODULE" ]]; then
  # Fail LOUD (journald captures dispatcher stderr) but fail CLOSED: never
  # block/fail the NM event itself over a misconfigured guard — matches the
  # guard's own "does nothing when it cannot prove breakage" philosophy.
  echo "k3s-clusterip-guard: dispatcher module not found at" \
       "'$DISPATCHER_MODULE' (set AUDITTRACE_REPO_DIR if this repo is not" \
       "checked out at the default location) — no action taken" >&2
  exit 0
fi

exec "$PYTHON_BIN" "$DISPATCHER_MODULE" "${1:-}" "${2:-}"
