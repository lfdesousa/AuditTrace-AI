# AuditTrace-AI — SPEC #443 (2026-08-09), the #307-family permanent fix's sibling.
#
# NetworkManager must NOT manage the k3s0 dummy interface (SPEC #443 s3). k3s0
# is created out-of-band by audittrace-k3s0-dummy.service (see
# scripts/network/audittrace-k3s0-dummy.service.template) BEFORE k3s starts —
# the SAME pattern #307's fix used for flannel.1/cni0 ("created externally,
# then marked unmanaged so NM never adopts and later flushes its routes").
#
# Note: flannel.1/cni0/veth*/cali* are ALREADY covered by the existing #307
# drop-in (~/work/audittrace-private/scripts/networkmanager-99-audittrace-k3s-
# unmanaged.conf, installed as /etc/NetworkManager/conf.d/99-audittrace-k3s-
# unmanaged.conf — its `flannel*` glob already matches `flannel.1`). This is a
# SEPARATE, ADDITIVE drop-in for the new `k3s0` interface only — do not merge
# it into the #307 file; keeping them separate makes each one's git-blame /
# incident trail independently legible.
#
# Why k3s0 is NOT an NM-managed connection profile (a deliberate SPEC #443
# design choice, documented in the build-record): a virtual `type=dummy` NM
# connection can only be brought up by NM ITSELF — but `unmanaged-devices`
# tells NM to never touch a matching interface name, including never
# activating a profile for it. Those two mechanisms are mutually exclusive for
# the SAME interface. k3s0 is therefore created by a plain systemd oneshot
# unit (kernel `ip link add`/`ip addr add`, no NM connection involved) and
# THEN excluded here — mirroring the flannel.1/cni0 precedent exactly, not
# fighting it.
#
# Apply (operator-gated, SPEC #443 s6 — never the fleet's to run):
#   sudo cp scripts/network/99-audittrace-k3s0-unmanaged.conf.template \
#           /etc/NetworkManager/conf.d/99-audittrace-k3s0-unmanaged.conf
#   sudo nmcli general reload   # non-disruptive; does not drop active connections
#   nmcli -t -f DEVICE,STATE device status | grep k3s0   # want: k3s0:unmanaged
[keyfile]
unmanaged-devices=interface-name:k3s0
