[Unit]
Description=AuditTrace-AI SPEC #443 — persistent k3s0 dummy interface (ClusterIP-path decoupling)
Documentation=file:///home/lfdesousa/work/AuditTrace-AI/scripts/network/audittrace-k3s0-dummy-up.sh
# Must run and complete BEFORE k3s starts: k3s.service's config.yaml pins
# `flannel-iface: k3s0` (see scripts/network/k3s-config.yaml.template) — if
# k3s0 does not exist yet when k3s starts, k3s falls straight back to
# auto-detecting the node IP from the default-route interface, which is
# SPEC #443's root cause (s2) recurring. Same ordering discipline as
# audittrace-vault-auto-unseal.service ("must complete before dependents
# start", not "eventually").
Before=k3s.service
After=network-pre.target
Wants=network-pre.target
# Soft dependency (Wants, not Requires) on network-pre.target — creating a
# dummy interface needs no physical link, but keeping the same soft-dependency
# idiom as the rest of this repo's host units (feedback_systemd_requires_vs_wants)
# avoids this unit's own first-boot ordering surprising a future edit.

[Service]
Type=oneshot
RemainAfterExit=yes
# NO User= — creating a kernel network interface (`ip link add`/`ip addr add`)
# needs CAP_NET_ADMIN; this unit runs as root deliberately, same as
# audittrace-mesh-healer.service. audittrace-k3s0-dummy-up.sh itself performs
# ONLY the bounded, idempotent k3s0-create operation — no general "run
# arbitrary root command" lever.
ExecStart=/usr/local/sbin/audittrace-k3s0-dummy-up.sh
ExecStop=/usr/bin/env bash -c 'ip link set k3s0 down 2>/dev/null || true'
TimeoutStartSec=30s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
