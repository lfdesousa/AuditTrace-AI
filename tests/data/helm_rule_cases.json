{
  "_comment": [
    "Shared case table for the helm positional ALLOW rule (ADDENDUM A3-2,",
    "A4-5, A5-3, A4-7, A4-8). Two independent implementations are driven",
    "over this table and must agree on every 'list' row: the Python rule",
    "in tests/conftest.py (tests/test_hermetic_cluster_tool_guard.py) and",
    "the bash shim in scripts/ci/run-tests.sh",
    "(tests/test_run_tests_sh_enforcement.py). 'shell' and 'executable'",
    "rows are Python-only (A5-3) — a shell=True string such as",
    "'helm template a b && helm delete r' is rejected WHOLE by the Python",
    "word check, while the bash shim would only ever see one argv at a",
    "time and judge each exec separately; that difference is intentional",
    "and is why those two forms are not driven through the shim.",
    "'expect' is 'allow' (REAL helm/the fake REAL_HELM runs) or 'raise'",
    "(HermeticClusterToolError in Python / the shim's reject log + exit 17)."
  ],
  "cases": [
    {"id": "template-safe", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace"], "expect": "allow"},
    {"id": "template-set", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--set", "foo=bar"], "expect": "allow"},
    {"id": "template-namespace", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--namespace", "audittrace"], "expect": "allow"},
    {"id": "template-set-json", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--set-json", "foo={}"], "expect": "allow"},
    {"id": "template-show-only", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--show-only", "templates/deployment.yaml"], "expect": "allow"},
    {"id": "template-set-string", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--set-string", "foo=bar"], "expect": "allow"},
    {"id": "template-combined-fqdn-shape", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--set", "externalLLM.host=llm.test.invalid", "--namespace", "audittrace", "--show-only", "templates/deployment.yaml"], "expect": "allow"},
    {"id": "lint-safe", "form": "list", "argv": ["helm", "lint", "charts/audittrace"], "expect": "allow"},
    {"id": "version-safe", "form": "list", "argv": ["helm", "version"], "expect": "allow"},
    {"id": "show-chart-safe", "form": "list", "argv": ["helm", "show", "chart", "charts/audittrace"], "expect": "allow"},
    {"id": "dependency-list-safe", "form": "list", "argv": ["helm", "dependency", "list", "charts/audittrace"], "expect": "allow"},
    {"id": "dependency-build-unsafe", "form": "list", "argv": ["helm", "dependency", "build", "charts/audittrace"], "expect": "raise", "note": "A4-7: dependency is restricted to list; build/update touch the network"},
    {"id": "dependency-update-unsafe", "form": "list", "argv": ["helm", "dependency", "update", "charts/audittrace"], "expect": "raise"},
    {"id": "dependency-bare-unsafe", "form": "list", "argv": ["helm", "dependency"], "expect": "raise"},
    {"id": "template-dry-run-server", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--dry-run=server"], "expect": "raise"},
    {"id": "template-dry-run-client", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--dry-run=client"], "expect": "raise"},
    {"id": "template-dry-run-bare", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--dry-run"], "expect": "raise"},
    {"id": "template-validate", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--validate"], "expect": "raise"},
    {"id": "template-kubeconfig", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--kubeconfig=/tmp/kc"], "expect": "raise"},
    {"id": "template-kube-context", "form": "list", "argv": ["helm", "template", "release", "charts/audittrace", "--kube-context=ctx"], "expect": "raise"},
    {"id": "upgrade-unsafe", "form": "list", "argv": ["helm", "upgrade", "release", "charts/audittrace"], "expect": "raise"},
    {"id": "install-unsafe", "form": "list", "argv": ["helm", "install", "release", "charts/audittrace"], "expect": "raise"},
    {"id": "uninstall-unsafe", "form": "list", "argv": ["helm", "uninstall", "release"], "expect": "raise"},
    {"id": "rollback-unsafe", "form": "list", "argv": ["helm", "rollback", "release", "1"], "expect": "raise"},
    {"id": "status-unsafe", "form": "list", "argv": ["helm", "status", "release"], "expect": "raise"},
    {"id": "get-unsafe", "form": "list", "argv": ["helm", "get", "values", "release"], "expect": "raise"},
    {"id": "list-unsafe", "form": "list", "argv": ["helm", "list"], "expect": "raise"},
    {"id": "history-unsafe", "form": "list", "argv": ["helm", "history", "release"], "expect": "raise"},
    {"id": "alias-delete-unsafe", "form": "list", "argv": ["helm", "delete", "release", "--set", "x=lint"], "expect": "raise", "note": "A3-2: a safe-looking VALUE (x=lint) must not rescue an unsafe subcommand"},
    {"id": "alias-del-unsafe", "form": "list", "argv": ["helm", "del", "release"], "expect": "raise"},
    {"id": "alias-un-unsafe", "form": "list", "argv": ["helm", "un", "release"], "expect": "raise"},
    {"id": "alias-ls-unsafe", "form": "list", "argv": ["helm", "ls"], "expect": "raise"},
    {"id": "alias-hist-unsafe", "form": "list", "argv": ["helm", "hist", "release"], "expect": "raise"},
    {"id": "bare-helm-unsafe", "form": "list", "argv": ["helm"], "expect": "raise"},
    {"id": "shell-template-then-delete", "form": "shell", "cmd": "helm template a b && helm delete r", "expect": "raise"},
    {"id": "shell-template-alone-still-raises", "form": "shell", "cmd": "helm template x", "expect": "raise", "note": "A3-2: ALLOW requires list-form, not shell=True — a shell=True string naming helm always raises, even one that LOOKS like a safe call, because the process-layer shim (not this diagnostic) is what actually judges a real shell-spawned helm"},
    {"id": "executable-matching-basename-allow", "form": "executable", "argv": ["helm", "template", "y"], "executable": "/usr/local/bin/helm", "expect": "allow", "note": "A4-8: executable= with a matching basename does not block an otherwise-safe list-form call"},
    {"id": "executable-mismatch-blocks-safe-looking-argv", "form": "executable", "argv": ["helm", "template", "y"], "executable": "not-helm", "expect": "raise", "note": "A3-2: executable= must itself be absent or basename helm — a mismatch blocks even a safe-looking argv"},
    {"id": "executable-decoy-argv0-raises-even-with-helm-executable", "form": "executable", "argv": ["x", "template", "y"], "executable": "helm", "expect": "raise", "note": "the digest's ALLOW rule requires basename(argv[0])==helm too — executable= does not substitute for a decoy argv[0]"},
    {"id": "executable-mismatch-unsafe", "form": "executable", "argv": ["helm", "template", "y"], "executable": "kubectl", "expect": "raise", "note": "A4-8: executable= names the REAL program; a 'helm template' argv under executable=kubectl is a kubectl call"}
  ]
}
