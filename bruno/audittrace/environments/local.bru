vars {
  baseUrl: http://localhost:8765
  realmIssuer: http://localhost:8081/realms/audittrace
  clientId: audittrace-opencode
  scope: openid memory:episodic:read memory:procedural:read memory:semantic:read memory:conversational:read-own memory:episodic:write memory:procedural:write memory:semantic:write memory:decisions:write memory:skills:write audittrace:query audittrace:context audittrace:audit audittrace:admin
  assessmentScope: openid audittrace:assessment:ingest
  langfuseUrl: http://192.168.1.231:3000
  tempoUrl: http://192.168.1.231:3200
  exampleAdrFile: ADR-bruno-test.md
  exampleSkillFile: SKILL-bruno-test.md
  exampleCollection: audittrace
  exampleDocId: bruno-probe
  indexFileKey: episodic/ADR-bruno-test.md
  auditLimit: 20
  auditSince: 1970-01-01T00:00:00Z
  indexPdfKey: episodic/main_signed.pdf
  indexPdfCollection: ai_research_papers
  uploadPdfFile: /tmp/clean.pdf
  mcpRecallQuery: AuditTrace architecture
  mcpWriteDocId: bruno-mcp-track-c-probe
  mcpBrokerServerName: example-server
  mcpBrokerToolName: example-tool
  authRequired: false
  chatPrompt: What does the ratified decision on the memory mode say? Look it up in the decisions memory with your memory tools and cite the source decision.
  chatSessionId:
  expectSourcesTrailer: false
  listLimit: 100
  listOffset: 0
  identityDocId: identity-check
  identityUserASub: replace-with-user-a-sub
  identityUserAName: replace-with-user-a-username
  inboundTraceparent: 00-0123456789abcdef0123456789abcdef-0123456789abcdef-01
}
