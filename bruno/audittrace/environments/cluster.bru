vars {
  baseUrl: https://audittrace.local:30952
  realmIssuer: https://audittrace.allaboutdata.eu:30952/realms/audittrace
  clientId: audittrace-opencode
  scope: openid memory:episodic:read memory:procedural:read memory:semantic:read memory:conversational:read-own memory:episodic:write memory:procedural:write memory:semantic:write memory:decisions:write memory:skills:write audittrace:query audittrace:context audittrace:audit audittrace:admin
  assessmentScope: openid audittrace:assessment:ingest
  langfuseUrl: http://localhost:3000
  tempoUrl: http://localhost:3200
  exampleAdrFile: ADR-bruno-test.md
  exampleSkillFile: SKILL-bruno-test.md
  exampleCollection: audittrace
  exampleDocId: bruno-probe
  indexFileKey: episodic/ADR-bruno-test.md
  auditLimit: 20
  auditSince: 1970-01-01T00:00:00Z
  indexPdfKey: episodic/main_signed.pdf
  indexPdfCollection: ai_research_papers
  uploadPdfFile: /tmp/clean.pdf
  mcpRecallQuery: AuditTrace architecture
  mcpWriteDocId: bruno-mcp-track-c-probe
  mcpBrokerServerName: example-server
  mcpBrokerToolName: example-tool
  authRequired: true
  aclResourceType: promptGroup
  aclResourceId: replace-with-the-owned-resource-id
  aclPrincipalId: replace-with-the-grantee-sub
  chatPrompt: What does the ratified decision on the memory mode say? Look it up in the decisions memory with your memory tools and cite the source decision.
  chatSessionId:
  contentPartType: file
  contentPartFilename: attachment.txt
  contentPartData: data:text/plain;base64,aGVsbG8gd29ybGQ=
  contentPartPrompt: Summarise the attached file.
  contentPartSessionId:
  imagePartData: data:image/png;base64,
  imagePartPrompt: Read the decision number written in this diagram, describe the diagram in one sentence, then use your memory tools to recall that decision and summarise it in two sentences.
  imagePartExpect: ADR-049
  imagePartSessionId:
  imagePartSha256: 3aede1459192d34f16574afefedb8a0e4cd03f4a60bda50ad6e32a0e62f60631
  imagePartBytes: 9189
  imageRefusedUrl: https://example.invalid/not-fetched.png
  imageRefusedCode: image_url_not_supported
  imageNoProjectorModel: mistral
  upstreamBadResponseFormatType: bogus
  upstream4xxSessionId:
  audioPartData: UklGRjQAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YRAAAAAAAAAAAAAAAAAAAAAAAAAA
  audioPartFormat: wav
  unknownPartCanary: Q0FOQVJZLTQ3NC1VTktOT1dOLVBBUlQtREFUQQ==
  audioTurnSessionId:
  expectSourcesTrailer: false
  listLimit: 100
  listOffset: 0
  identityDocId: identity-check
  identityUserASub: replace-with-user-a-sub
  identityUserAName: replace-with-user-a-username
  inboundTraceparent: 00-0123456789abcdef0123456789abcdef-0123456789abcdef-01
}
