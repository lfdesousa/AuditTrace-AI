meta {
  name: W4 POST grants/bulk
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/console/acl/{{aclResourceType}}/{{aclResourceId}}/grants/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "ops": [
      {"principal_type": "user", "principal_id": "{{aclPrincipalId}}", "perm_bits": 1}
    ]
  }
}

tests {
  test("200 + ids", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().acl_entry_ids).to.be.an("array");
  });
}

docs {
  All-or-nothing on ONE resource (the path's). An op cannot name another resource.
}
