meta {
  name: GET /memory/semantic/{collection}/{doc_id} — read
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/memory/semantic/{{exampleCollection}}/{{exampleDocId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the expected status (expectedReadStatus, default 200)", function() {
    expect(res.getStatus()).to.equal(Number(bru.getEnvVar("expectedReadStatus")));
  });
  test("a refused read carries no content, title, size or deleted marker", function() {
    if (res.getStatus() === 200) { return; }
    const text = JSON.stringify(res.getBody());
    expect(res.getBody()).to.not.have.property("content");
    expect(res.getBody()).to.not.have.property("manifest");
    expect(text).to.not.contain("deleted");
  });
  test("returns content + metadata + manifest (a 200 only)", function() {
    if (res.getStatus() !== 200) { return; }
    const body = res.getBody();
    expect(body.content).to.be.a("string");
    expect(body.metadata.collection).to.equal(bru.getEnvVar("exampleCollection"));
  });
}

docs {
  `expectedReadStatus` (default 200) is the status the run expects: 404 for a chunk whose
  document the caller soft-deleted (any chunk of it), 200 for an admin or a live document.

  Reads one document from ChromaDB by (collection, document_id).
  404 if either is unknown. Returns the embedding's stored text
  (not a re-decoded vector).
}
