meta {
  name: GET /interactions?trace_id=<SERVER> — positive control, exactly the 04 interaction
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/interactions?trace_id={{serverTraceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  // Each id is the runtime var stashed by 04/05 (chained run) or, failing
  // that, an env var passed with --env-var (standalone run).
  const fromRunOrEnv = (n) => bru.getVar(n) || bru.getEnvVar(n);
  const serverTraceId = fromRunOrEnv("serverTraceId");
  const serverInteractionId = fromRunOrEnv("serverInteractionId");
  const inboundSessionId = fromRunOrEnv("inboundSessionId");
  test("precondition: 05 stashed the server ids or they were passed as --env-var (not vacuous)", function() {
    expect(String(serverTraceId)).to.match(/^[0-9a-f]{32}$/);
    expect(String(serverInteractionId)).to.match(/^[0-9]+$/);
  });
  test("returns 200 with exactly the interaction written by 04", function() {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody().interactions;
    expect(rows).to.have.lengthOf(1);
    expect(String(rows[0].id)).to.equal(String(serverInteractionId));
    expect(rows[0].trace_id).to.equal(serverTraceId);
    expect(rows[0].session_id).to.equal(inboundSessionId);
  });
}

docs {
  TRACEPARENT-TRUST step 5: positive control for 06. Same filter, server
  trace id -> the one interaction 04 produced.
}
