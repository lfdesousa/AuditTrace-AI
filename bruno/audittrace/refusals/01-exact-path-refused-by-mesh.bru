meta {
  name: POST /interactions/refusals — exact path, front door (mesh refuses)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/interactions/refusals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "route": "chat",
    "code": "invalid_token",
    "http_status": 401,
    "subject_token": "not-a-token",
    "session_id": "e8-refusal-path-check"
  }
}

tests {
  test("answers exactly 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  BFF-CHAT-ROUTE-ERRORS E8. The refused-turn ingest route admits only the
  LibreChat BFF as the immediate mesh peer, and only on the exact path.
  Through the front door with an ordinary user token: the exact path answers 403 (the mesh policy).
  A 201 or 422 here fails the gate. The body carries no real token
  ("not-a-token"); the request must be refused before any validation.
  Afterwards, the session "e8-refusal-path-check" must hold no row.
}
