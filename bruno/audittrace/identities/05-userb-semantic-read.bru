meta {
  name: GET /memory/semantic/{collection}/{doc_id} — user B reads own doc
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/memory/semantic/{{exampleCollection}}/{{identityDocId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUserB}}
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("content is user B's text", function() {
    expect(res.getBody().content).to.contain("user B");
  });
}

docs {
  Each identity reads its OWN row under the shared logical key.
}
