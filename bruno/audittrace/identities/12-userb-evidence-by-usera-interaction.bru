meta {
  name: GET /evidence/interactions/{id} — user B asks for user A's audit row
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/evidence/interactions/{{evidenceInteractionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUserB}}
}

tests {
  test("404 with the framework's own Not Found body", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ detail: "Not Found" });
  });
}

docs {
  CONSOLE-AUDIT-EVIDENCE WU-A, second identity. `evidenceInteractionId` is the id of
  an audit row owned by user A (pass `--env-var evidenceInteractionId=<id>`); sent as
  user B. Expected: 404 `{"detail":"Not Found"}`, the same as an unknown id.

  Token slot: `{{tokenUserB}}`, filled by `scripts/audittrace-login --env-key tokenUserB`, logged in as a DIFFERENT Keycloak user than the one who owns the console turn, with the default client.
  Every login rewrites the CLI token store under `~/.config/audittrace`; `--env-key`
  leaves the `.env` default pair (`accessToken`) untouched, so only the slot changes
  in the collection. Restore the default login afterwards, as the operator's own
  Keycloak user: `AUDITTRACE_EXTRA_SCOPES="memory:episodic:write memory:procedural:write memory:decisions:write memory:semantic:write" scripts/audittrace-login` with `CLIENT_ID` unset.
}
