meta {
  name: GET /evidence/messages/{id} — restricted client (no audittrace:audit)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/evidence/messages/{{clientMessageId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUserA}}
}

tests {
  test("403, the missing scope named, nothing about the row", function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.deep.equal({ detail: "Required scope: audittrace:audit" });
  });
}

docs {
  CONSOLE-AUDIT-EVIDENCE WU-A, SC-09. The restricted client holds no
  `audittrace:audit`, so the route refuses before any lookup: 403
  `{"detail":"Required scope: audittrace:audit"}`. `clientMessageId` as in 10.

  Token slot: `{{tokenUserA}}`, filled by
  `CLIENT_ID=audittrace-restricted scripts/audittrace-login --env-key tokenUserA`
  (the SC-09 restricted client: it holds no `audittrace:audit`). Restore the default
  login afterwards (it is overwritten by slot logins): `AUDITTRACE_EXTRA_SCOPES="memory:episodic:write
  memory:procedural:write memory:decisions:write memory:semantic:write"
  scripts/audittrace-login` with `CLIENT_ID` unset, and re-login user A with
  `--env-key tokenUserA` on the default client if the semantic identity requests are
  to be run again.
}
