meta {
  name: GET /evidence/interactions/{id} — restricted client (no audittrace:audit)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/evidence/interactions/{{evidenceInteractionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUserA}}
}

tests {
  test("403, the missing scope named, nothing about the row", function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.deep.equal({ detail: "Required scope: audittrace:audit" });
  });
}

docs {
  CONSOLE-AUDIT-EVIDENCE WU-A, SC-09. As 13 on the interaction route: 403
  `{"detail":"Required scope: audittrace:audit"}`. `evidenceInteractionId` as in 12.

  Token slot: `{{tokenUserA}}`, filled by `CLIENT_ID=audittrace-restricted scripts/audittrace-login --env-key tokenUserA` (the SC-09 restricted client: it holds no `audittrace:audit`).
  Every login rewrites the CLI token store under `~/.config/audittrace`; `--env-key`
  leaves the `.env` default pair (`accessToken`) untouched, so only the slot changes
  in the collection. Restore the default login afterwards, as the operator's own
  Keycloak user: `AUDITTRACE_EXTRA_SCOPES="memory:episodic:write memory:procedural:write memory:decisions:write memory:semantic:write" scripts/audittrace-login` with `CLIENT_ID` unset, and re-login user A with `--env-key tokenUserA` on the default client if the semantic identity requests are to be run again.
}
