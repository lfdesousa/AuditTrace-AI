meta {
  name: session-recall 06 - GET /interactions?session_id= (the audit trail of this chat)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/interactions?session_id={{chatSessionId}}
  body: none
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200 and only this chat's interactions", function() {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody().interactions;
    expect(rows).to.be.an("array").with.lengthOf.at.least(1);
    rows.forEach(r => expect(r.session_id).to.equal(bru.getVar("chatSessionId") || bru.getEnvVar("chatSessionId")));
  });
}

docs {
  RLS-scoped to the caller (needs `audittrace:audit`, a default scope of the
  `audittrace-session-e2e` client). Each row carries `trace_id`; follow it
  with `audit/02-list-by-trace-id` and `GET /interactions/{id}/tool-calls`
  to see the `recall_attachments` tool_calls row of 03/04.
}
