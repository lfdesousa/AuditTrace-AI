meta {
  name: session-recall 05 - MCP tools/call recall_attachments under this chat id
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 5,
    "method": "tools/call",
    "params": {
      "name": "recall_attachments",
      "arguments": { "n": 5 }
    }
  }
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200 with a JSON-RPC result and no error", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.jsonrpc).to.equal("2.0");
    expect(body).to.not.have.property("error");
    expect(body.result.isError).to.equal(false);
  });
  test("exactly the one note uploaded under this chat id", function() {
    const sc = res.getBody().result.structuredContent;
    expect(sc.total).to.equal(1);
    expect(sc.matches[0].title).to.equal(bru.getEnvVar("sessionNoteName"));
  });
}

docs {
  The MCP transport path of the same compartment: the id comes from the
  header only, never from the tool arguments.
}
