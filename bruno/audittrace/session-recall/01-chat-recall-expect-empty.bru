meta {
  name: session-recall 01 - chat recall under a fresh chat id (expect EMPTY)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "model": "audittrace-default",
    "messages": [
      { "role": "user", "content": "{{sessionRecallPrompt}}" }
    ],
    "stream": false,
    "max_tokens": 1024
  }
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("a fresh chat id recalls nothing: the note's file name is absent", function() {
    const text = JSON.stringify(res.getBody());
    expect(text).to.not.include(bru.getEnvVar("sessionNoteName"));
  });
}

docs {
  LC-10a (per-chat session recall). Run BEFORE 02: under a chat id that has
  uploaded nothing, `recall_attachments` returns no match, so the answer never
  names `sessionNoteName`. Uses the `audittrace-session-e2e` device-flow
  client (env `cluster-session-e2e`): scopes audittrace:query,
  memory:session:read-own (optional, requested by name).
}
