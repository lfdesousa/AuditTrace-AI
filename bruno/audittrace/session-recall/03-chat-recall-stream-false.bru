meta {
  name: session-recall 03 - chat recall, same chat id, stream:false (expect the note)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "model": "audittrace-default",
    "messages": [
      { "role": "user", "content": "{{sessionRecallPrompt}}" }
    ],
    "stream": false,
    "max_tokens": 1024
  }
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("the note uploaded under THIS chat id is recalled (file name present)", function() {
    const text = JSON.stringify(res.getBody());
    expect(text).to.include(bru.getEnvVar("sessionNoteName"));
  });
}

docs {
  Same chat id as 02 (runtime variable `chatSessionId`): the model calls
  `recall_attachments` and the answer names the uploaded file. A different
  chat id would recall nothing (see 01, and the second-user run in the
  README of this folder).
}
