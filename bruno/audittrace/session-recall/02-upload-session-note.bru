meta {
  name: session-recall 02 - POST /memory/upload?layer=session under this chat id
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/memory/upload?layer=session&filename={{sessionNoteName}}
  body: multipartForm
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

query {
  layer: session
  filename: {{sessionNoteName}}
}

body:multipart-form {
  file: @file({{uploadSessionFile}})
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  LC-10a: writes the note into the caller's session layer, compartment =
  the `X-Session-Id` of this run. Needs `memory:session:write` (OPTIONAL on
  the `audittrace-session-e2e` client; requested by name in the env's
  `scope`). Prepare the fixture first: a short plain-text file at
  `uploadSessionFile` (default /tmp/lc10a-session-note.md). An upload with no
  valid header would be stored with a NULL compartment and recalled by no
  chat (strict, operator Q6).
}
