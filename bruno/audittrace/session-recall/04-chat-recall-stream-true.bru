meta {
  name: session-recall 04 - chat recall, same chat id, stream:true (expect the note in the SSE frames)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

headers {
  X-Session-Id: {{chatSessionId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "model": "audittrace-default",
    "messages": [
      { "role": "user", "content": "{{sessionRecallPrompt}}" }
    ],
    "stream": true,
    "max_tokens": 1024
  }
}

script:pre-request {
  // LC-10a: ONE chat session id per run. A caller pins it with
  // --env-var chatSessionId=...; otherwise a fresh value is generated once and
  // shared by every request of the run (runtime variable), so "upload under
  // this chat, recall under this chat" is a real same-session check and rows
  // from earlier runs never share it. The id has the server's accepted shape
  // (printable ASCII, no space, 1-255 chars).
  if (!bru.getEnvVar("chatSessionId") && !bru.getVar("chatSessionId")) {
    bru.setVar(
      "chatSessionId",
      "bru-s4-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)
    );
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("the streamed answer names the uploaded file", function() {
    // The file name is split across token deltas, so scan the ASSEMBLED text
    // (choices[].delta.content of every `data:` frame), never the raw SSE.
    const body = res.getBody();
    const raw = typeof body === "string" ? body : JSON.stringify(body);
    let assembled = "";
    for (const line of raw.split("\n")) {
      const t = line.trim();
      if (!t.startsWith("data:")) continue;
      const payload = t.slice(5).trim();
      if (payload === "" || payload === "[DONE]") continue;
      try {
        for (const choice of (JSON.parse(payload).choices || [])) {
          const piece = choice.delta && choice.delta.content;
          if (typeof piece === "string") assembled += piece;
        }
      } catch (e) {
        // a non-JSON data frame carries no delta text
      }
    }
    expect(assembled).to.include(bru.getEnvVar("sessionNoteName"));
  });
}

docs {
  The streaming twin of 03: the tool loop runs inside the response stream,
  so the bound session id must still be visible there (WP-6 binder). The
  assertion reads the concatenated delta text of all frames: a file name is
  split across token deltas and never appears whole in the raw SSE.
}
